{
  "name": "yesmusic-dj-helper",
  "productName": "YesMusicDJHelper",
  "version": "1.0.0",
  "description": "DJ 专属网易云音乐助手与本地音频转换转码器",
  "author": "ziyan2006",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "test": "node --test test/*.test.js",
    "build:dir": "electron-builder --dir",
    "build:portable": "electron-builder --win portable",
    "build:nsis": "electron-builder --win nsis",
    "dist": "electron-builder --win dir portable"
  },
  "build": {
    "appId": "com.yesmusic.djhelper",
    "productName": "YesMusic DJ Helper",
    "directories": {
      "output": "dist_app"
    },
    "asar": true,
    "asarUnpack": [
      "**/ffmpeg-static/**",
      "**/node_modules/ffmpeg-static/**"
    ],
    "files": [
      "main.js",
      "preload.cjs",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/chrome-win",
        "to": "chrome-win",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YesMusic DJ Helper"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.7.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-real-browser": "^1.4.4"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
