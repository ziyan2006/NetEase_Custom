{
  "name": "yesmusic-dj-helper",
  "productName": "YesMusicDJHelper",
  "version": "1.0.0",
  "description": "DJ 专属网易云音乐助手与本地音频转换转码器",
  "author": "ziyan2006",
  "private": true,
  "type": "module",
  "main": "main.js",
  "workspaces": [
    "renderer"
  ],
  "scripts": {
    "start": "npm run build:ui && node server.js",
    "electron": "npm run build:ui && electron .",
    "dev:ui": "npm run dev --workspace yesmusic-dj-renderer",
    "build:ui": "npm run build --workspace yesmusic-dj-renderer",
    "harness:web": "node harness/start.mjs",
    "test": "node --test test/*.test.js",
    "build:dir": "npm run build:ui && electron-builder --dir",
    "build:portable": "npm run build:ui && electron-builder --win portable",
    "build:nsis": "npm run build:ui && electron-builder --win nsis",
    "dist": "npm run build:ui && electron-builder --win dir portable"
  },
  "build": {
    "appId": "com.yesmusic.djhelper",
    "productName": "YesMusic DJ Helper",
    "directories": {
      "output": "dist_app"
    },
    "asar": true,
    "asarUnpack": [
      "**/ffmpeg-static/**",
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/better-sqlite3/**",
      "harness/**"
    ],
    "files": [
      "main.js",
      "preload.cjs",
      "server.js",
      "load-env.js",
      "lib/**/*",
      "harness/*.mjs",
      "harness/skills/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin/chrome-win",
        "to": "chrome-win",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YesMusic DJ Helper"
    }
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-protocol": "0.1.0-rc.6",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.6",
    "better-sqlite3": "^13.0.3",
    "ffmpeg-static": "^5.3.0",
    "puppeteer-core": "^25.7.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-real-browser": "^1.4.4"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  }
}
