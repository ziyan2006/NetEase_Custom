{
  "name": "yesmusic-dj-helper",
  "productName": "YesMusicDJHelper",
  "version": "1.0.0",
  "description": "DJ 专属网易云音乐助手与本地音频转换转码器",
  "author": "ziyan2006",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "npx electron .",
    "test": "node --test test/*.test.js",
    "pack": "npx @electron/packager . YesMusicDJHelper --platform=win32 --arch=x64 --out=dist_app --overwrite --electron-version=34.3.0",
    "dist": "npx electron-builder --win nsis --config.electronVersion=34.3.0"
  },
  "build": {
    "appId": "com.yesmusic.djhelper",
    "productName": "YesMusic DJ Helper",
    "directories": {
      "output": "dist_installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "lib/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "YesMusic DJ Helper"
    }
  },
  "dependencies": {
    "puppeteer-core": "^25.7.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-real-browser": "^1.4.4"
  }
}
